--text-title:   clamp(28px, 2.6vw, 36px); --text-title--line-height: 1.08;
--text-display: clamp(30px, 3.4vw, 42px); --text-display--line-height: 1.05;
--text-hero:    clamp(44px, 6.5vw, 68px);
--font-mono: initial;
--font-ui:      var(--font-geist), ui-sans-serif, system-ui, sans-serif;
