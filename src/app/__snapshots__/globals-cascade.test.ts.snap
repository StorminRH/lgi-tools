--shadow-field-inset: inset 0 2px 6px rgba(0, 0, 0, 0.45);
--shadow-field-focus: inset 0 2px 6px rgba(0, 0, 0, 0.45);
--shadow-btn-bezel:   0 1px 0 rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.04);
