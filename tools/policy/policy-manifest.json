{
  "developmentState": {
    "resolver": "tools/lifecycle/resolve_development_state.py",
    "allowedStages": [
      "master-plan-needed",
      "contracts-needed",
      "contract-repair-needed",
      "session-plan-needed",
      "session-ready",
      "promote-needed",
      "archive-needed",
      "invalid"
    ],
    "allowedHandlers": [
      "plan-version",
      "plan-session",
      "start-session",
      "close-out"
    ],
    "allowedModes": [
      "plan",
      "execute",
      "report"
    ],
    "directiveFields": [
      "action",
      "reason",
      "handler",
      "mode",
      "authority",
      "primaryArtifact",
      "pause",
      "branch",
      "preDispatchGate"
    ],
    "preDispatchGate": "python3 tools/cli.py lifecycle check-release --check",
    "legacySchemaArtifacts": []
  },
  "procedurePolicies": {
    "docs/workflows/schema/session-plan.md": {
      "orderedRequired": [
        "starting execution prompt",
        "without returning to",
        "Proof standard",
        "dedicated Ordered work step whose",
        "Proof identifiers are unique and contiguous"
      ]
    },
    "docs/workflows/schema/session-as-built.md": {
      "orderedRequired": [
        "Plan statement",
        "Built instead",
        "Authority",
        "cannot invent authority after the fact",
        "one ordered line per plan criterion",
        "requested and observed runtime identity separately"
      ]
    }
  }
}
