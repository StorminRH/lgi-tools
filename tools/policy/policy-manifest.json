      "python3 \"$CURSOR_PROJECT_DIR/tools/cli.py\" policy codegraph-guard cursor"
    ],
    ".claude/settings.json": [
      "python3 \"$(git rev-parse --show-toplevel)/tools/cli.py\" policy codegraph-guard bash",
      "python3 \"$(git rev-parse --show-toplevel)/tools/cli.py\" policy codegraph-guard read"
    ],
    ".codex/hooks.json": [
      "python3 \"$(git rev-parse --show-toplevel)/tools/cli.py\" policy codegraph-guard bash",
      "python3 \"$(git rev-parse --show-toplevel)/tools/cli.py\" policy codegraph-guard read"
    ]
