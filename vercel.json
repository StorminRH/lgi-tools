{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "development": false,
      "staging": true,
      "**": false,
      "*": false,
      "*/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-batch",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/refresh-gsc",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/refresh-sde",
      "schedule": "0 14 * * *"
    }
  ]
}
